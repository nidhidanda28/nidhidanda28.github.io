penguins_nest <- penguins |>
group_by(species, island) |>
nest()
penguins_nest
penguins_unnest <- penguins_nest |>
unnest()
penguins_nest
weather_nested <- weather |>
group_by(origin, month) |>
nest() |>
mutate(
min_temp = map_dbl(data, ~min(.$temp, na.rm = TRUE)),
max_temp = map_dbl(data, ~max(.$temp, na.rm = TRUE)),
avg_temp = map_dbl(data, ~mean(.$temp, na.rm = TRUE))
)
weather_nested
# TESTS
test_that("weather_nested loads successfully", {
expect_true(exists("weather_nested"))
expect_s3_class(weather_nested, "tbl_df")
})
test_that("weather_nested has the correct dimensions", {
expect_equal(nrow(weather_nested), 36)
expect_equal(ncol(weather_nested), 6)
})
test_that("weather_nested has the correct column names and types", {
expect_named(weather_nested, c("origin", "month", "data", "min_temp", "max_temp", "avg_temp"), ignore.order = TRUE)
expect_type(weather_nested$origin, "character")
expect_type(weather_nested$min_temp, "double")
expect_type(weather_nested$data, "list")
})
test_that("weather_nested keeps the rest of the data nested", {
expect_equal(ncol(weather_nested$data[[1]]), 13)
expect_equal(nrow(weather_nested$data[[1]]), 742)
expect_equal(round(sum(arrange(weather_nested, origin, month)$data[[1]]$wind_speed, na.rm = TRUE)), 7327)
})
test_that("weather_nested has the correct summary statistics", {
expect_equal(round(sum(weather_nested$min_temp, na.rm = TRUE)), 1292)
expect_equal(round(sum(weather_nested$max_temp, na.rm = TRUE)), 2814)
expect_equal(round(sum(weather_nested$avg_temp, na.rm = TRUE)), 1983)
})
#' Filter row based on string matching
#'
#' this function takes a data frame and keeps rows where a column contains full or partial string match.
#'
#' @param data data frame to filter
#' @param col unquoted column to search for
#' @param pattern pattern to string search for
#'
#' @return a data frame that contains the rows that have a full or partial string match
#'
#' @examples
#' df <- data.frame(name = c("Ali", "Bob", "Alice", "Nick")
#' filter(df, name, 'Ali')
filter_str_match <- function(data, col, pattern){
# erroneous user inputs
if (!is.data.frame(data)){
stop("'data' should be a data frame.")
}
if (!is.character(pattern) || length(pattern) != 1){
stop("pattern must be of length 1.")
}
filter(data, str_detect({{ col }}, pattern))
}
df <- data.frame(
name = c("Ali", "Bob", "Alice", "Nick"),
age = c(20, 25, 35, 22)
)
filter_str_match(df, name, "Ali")
test_that("'data' should be a data frame.",  {
df <- data.frame(name = c("Alice", "Bob"))
expect_error(filter_str_match(df, name, 22))
})
test_that("filter_str_match finds full matches", {
df<- data.frame(name = c("Alice", "Bob", "Charlie"))
result <- filter_str_match(df, name, "Alice")
expect_equal(result$name, "Alice")
})
test_that("filter_str_match finds partial matches", {
df <- data.frame(name = c("Alicia", "Bob", "Alice", "Charlie"))
result <- filter_str_match(df, name, "Ali")
expect_equal(result$name, c("Alicia", "Alice"))
})
char_change <- function(data, col, pattern, replacement) {
# erroneous inputs
if (!is.data.frame(data)){
stop("'data' should be a data frame.")
}
if (!is.character(pattern) || length(pattern) != 1) {
stop("'pattern' must be of length 1")
}
if (!is.character(replacement) || length(replacement) != 1) {
stop("'replacement' must be of length 1")
}
mutate(data, {{ col }} := str_replace{{ col }}, pattern, replacement)
}
data <- data.frame(
country = c('Cdn', 'US', 'Mexico', 'UK'),
num = c(1, 2, 3, 4),
stringAsFactors = FALSE
)
test_that("char_change replaces specific character strings", {
result <- char_change(data, 'Cdn', 'Canada')
expect_equal(result$country, c('Canada', 'US', 'Mexico', 'UK'))
})
